    "@angular/forms":            "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/router":           "^17.3.0",
    "rxjs":                      "~7.8.0",
    "tslib":                     "^2.6.0",
    "zone.js":                   "~0.14.0",
    "leaflet":                   "^1.9.4",
    "@types/leaflet":            "^1.9.8",
    "chart.js":                  "^4.4.2",
    "ng2-charts":                "^6.0.1",
    "date-fns":                  "^3.6.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli":                  "^17.3.0",
    "@angular/compiler-cli":         "^17.3.0",
    "typescript":                    "~5.4.0",
    "karma":                         "~6.4.0",
    "karma-chrome-launcher":         "~3.2.0",
    "karma-jasmine":                 "~5.1.0",
    "jasmine-core":                  "~5.1.0",
    "@types/jasmine":                "~5.1.0"
