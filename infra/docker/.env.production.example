# ═══════════════════════════════════════════════════════════════
# .env.production.example — Sen_Parcelle Production Variables
# ═══════════════════════════════════════════════════════════════
# Copy to .env.production and fill all values before deploying.
#   cp .env.production.example .env.production
# ═══════════════════════════════════════════════════════════════

# ─── Django ───
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,your-server-ip
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:4200
CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://localhost:4200
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False

# ─── Database (PostGIS) ───
DB_NAME=sen_parcelle
DB_USER=sen_parcelle
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=db
DB_PORT=5432
CONN_MAX_AGE=60

# ─── Redis ───
REDIS_URL=redis://:your-redis-password@redis:6379/0
REDIS_PASSWORD=change-me-to-a-redis-password

# ─── Gunicorn ───
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# ─── Celery ───
CELERY_CONCURRENCY=4
CELERY_TASK_ALWAYS_EAGER=False

# ─── Email (SMTP) ───
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@sen-parcelle.sn
SERVER_EMAIL=alert@sen-parcelle.sn
ADMIN_EMAIL=admin@sen-parcelle.sn

# ─── AWS S3 (stockage fichiers) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=sen-parcelle-media
AWS_S3_REGION_NAME=eu-west-3
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ENDPOINT_URL=

# ─── Sentry (monitoring) ───
SENTRY_DSN=

# ─── Web3 / Blockchain ───
POLYGON_RPC_URL=https://polygon-mumbai.infura.io/v3/your-project-id
POLYGON_CHAIN_ID=80001
POLYGON_CONTRACT_ADDRESS=
POLYGON_PRIVATE_KEY=
POLYGONSCAN_API_KEY=

# ─── Mobile Push (Firebase FCM) ───
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ─── API Tiers ───
WAVE_API_KEY=
WAVE_SECRET_KEY=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
