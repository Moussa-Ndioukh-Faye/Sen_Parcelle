# .gitignore — Sen_parcelle
# Fichier généré pour ignorer les fichiers inutiles dans Git

# Python / Django
__pycache__/
*.py[cod]
*.so
*.egg-info/
/dist/
/build/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg

# Virtual environments
/venv/
/ENV/
/env/

# Django
*.log
*.pot
db.sqlite3
media/
staticfiles/
.env
.env.*
!.env.example
!.env.production.example

# Node / Blockchain
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.cache/
artifacts/
coverage/
typechain/

# Flutter / Dart
.dart-tool/
.pub/
.build/
.dart_tool/
*.flutter-plugins
*.flutter-plugins-dependencies
*.package_blob
*.package_config.json
.flutter-plugins-dependencies
# /android/  <-- Commented out to allow these if they exist
# /ios/
# /linux/
# /macos/
# /web/      <-- This was ignoring the web directory!
web/dist/
web/.angular/
/test_data/

# Reports / Audit
backend/.coverage
bandit-report.json
mobile/dart-analyze-report.txt
blockchain/npm-audit-blockchain.json
web/npm-audit-web.json

# Build output
mobile/build/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.DS_Store
Desktop.ini
Thumbs.db

# Logs / Temp
logs/
*.log
tmp/
temp/
*.tmp
*.cache
.session/

# OS
Thumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride
infra/backups/

# Certificats SSL de développement (générés par infra/scripts/gen-ssl-dev.sh)
infra/nginx/ssl/*.key
infra/nginx/ssl/*.crt
